# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API
# Leave both empty to run in DEMO MODE (data is saved in your browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: set to true after you deploy the "assistant" edge function (see README step 7)
VITE_USE_AI_FUNCTION=false

# Optional: where the Feedback form emails the author when running in demo mode
VITE_FEEDBACK_EMAIL=
